+// ---- Reminders --------------------------------------------------------------------------------------------------
+
+// A line of the history out of context: what an older memory message observed, a prompt or the assistant's text.
+export type Reminder = { at?: number; who: string; text: string }
+export const REMIND_MAX = 5
+const REMIND_LINE_CHARS = 300
+const REMIND_MIN_TERMS = 2
+// A whole term that names something: a path, a file, a flag, snake_case, camelCase, a CONSTANT, a word with a digit.
+const TERM = /(?:--)?[A-Za-z0-9_][\w./@-]*[A-Za-z0-9_]/g
+const isName = (t: string) =>
+  t.length >= 4 && (/[_/]|\.\w/.test(t) || /[a-z][A-Z]/.test(t) || /^[A-Z][A-Z0-9]{2,}$/.test(t) || (/\d/.test(t) && /[A-Za-z]/.test(t)) || t.startsWith('--'))
+function names(text: string) {
+  const out = new Set<string>()
+  for (const [t] of text.matchAll(TERM))
+    if (isName(t)) {
+      out.add(t)
+      const file = t.slice(t.lastIndexOf('/') + 1)
+      if (file !== t && isName(file)) out.add(file)
+    }
+  return out
+}
+/**
+ * At most REMIND_MAX lines of `cold` that share REMIND_MIN_TERMS or more names with `work` (the current goal and the
+ * raw tail) and are not already in `context`, rarest names first; in time order. None when no line shares enough.
+ */
+export function reminders(cold: readonly Reminder[], work: string, context: string): Reminder[] {
+  const wanted = names(work)
+  const lines = cold.map((r) => ({ ...r, text: clip(oneLine(r.text), REMIND_LINE_CHARS) })).filter((r, k, all) => r.text && all.findIndex((o) => o.text === r.text) === k)
+  const terms = lines.map((r) => names(r.text))
+  const df = new Map<string, number>()
+  for (const ts of terms) for (const t of ts) df.set(t, (df.get(t) ?? 0) + 1)
+  const flat = oneLine(context)
+  return lines
+    .map((r, k) => {
+      const shared = [...terms[k]!].filter((t) => wanted.has(t))
+      return { r, k, n: shared.length, score: shared.reduce((s, t) => s + Math.log(lines.length / df.get(t)!), 0) }
+    })
+    .filter((x) => x.n >= REMIND_MIN_TERMS && !flat.includes(x.r.text.replace(/…$/, '')))
+    .sort((a, b) => b.score - a.score || b.k - a.k)
+    .slice(0, REMIND_MAX)
+    .sort((a, b) => a.k - b.k)
+    .map((x) => x.r)
+}
+/** One reminder as a line: its time as om_recall takes it, who said it, and its text. */
+export const renderReminder = (r: Reminder) => `- ${r.at === undefined ? '' : `${day(r.at)} ${hhmm(r.at)} `}${r.who}: ${r.text}`
