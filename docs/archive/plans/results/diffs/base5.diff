+  const start = text.indexOf(REPLIES)
+  if (start < 0 || start > text.indexOf('<observations>\n')) return { replies, start, end: 0 }
+  const entry = /\* You(?: @ ([\d:]+))? \((\d+) chars\):\n|@ (\d{4}-\d{2}-\d{2})\n/y
