+// A lookup that failed because its path is missing: the path, as the call or the error names it. Unlike other
+// failed lookups it says something (the file is not there), so it is carried until a later call finds the path.
+const MISSING_PATH = /No such file or directory|cannot access|does not exist|ENOENT/
+function missingPath(f: Pick<OpenFailure, 'tool' | 'target' | 'error'>) {
+  if (!MISSING_PATH.test(f.error)) return undefined
+  if (f.tool !== 'Bash') return f.target || undefined
+  const m = /(?:cannot (?:access|open|stat)|No such file or directory:?) '([^']+)'|([^\s:'"`]+): No such file or directory/.exec(f.error)
+  return m?.[1] ?? m?.[2]
+}
 // Whether a successful call clears an open failure: the same tool and target, or a Bash command that runs the same
-// programs on the same operands.
+// programs on the same operands; a failed lookup of a missing path, any successful call that names its file.
 function clears(f: OpenFailure, b: Block, cwd: string, home?: string) {
-  if (b.kind !== 'tool' || !b.result || b.result.isError || b.name !== f.tool) return false
+  if (b.kind !== 'tool' || !b.result || b.result.isError) return false
+  // Only a failed lookup: a command that also ran something else (`ls $F; pdftotext $F`) may have failed at that too.
+  const gone = f.tool !== 'Bash' || inspects(f.target, cwd, home) ? missingPath(f) : undefined
+  const file = gone?.replace(/\/+$/, '').split('/').at(-1)
+  if (file && file.length >= 3 && JSON.stringify(b.input).includes(file)) return true
+  if (b.name !== f.tool) return false
   if (failureTarget(b, cwd, home) === f.target) return true
   const command = commandOf(b)
   const keys = f.tool === 'Bash' ? runKeys(f.target) : []
@@ -799,8 +813,8 @@
