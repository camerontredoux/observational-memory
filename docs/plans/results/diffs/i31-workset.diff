+const STAMPED = String.raw`(?:an unknown time|(\d{4}-\d\d-\d\d) (\d\d:\d\d))`
+const SEEN_LINE = new RegExp(String.raw`^- \`([^\`]*)\`: (read|edited) at ${STAMPED}(?:, (read|edited) at ${STAMPED})?(?:; (?:un)?changed on disk since)?\.$`)
