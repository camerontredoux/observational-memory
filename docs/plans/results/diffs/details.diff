+// The specific details the assistant stated in rows [from, to), in the order it stated them: backticked terms,
+// versions, numbers with a unit, constants, PR and commit ids, and paths. Tool calls and results are left out, as are
+// details a user message holds already. The Observer is given them to put on the lines of the events they belong to.
+const DETAIL = /`([^`\n]{2,80})`|(\bv?\d+\.\d+(?:\.\d+)+\b|\bv\d+(?:\.\d+)?\b|\b\d[\d,.]*\s?(?:%|ms|s|k|K|M|KB|MB|GB|tokens?|lines?|files?|tests?|calls?|x)(?!\w)|\b\d{1,3}(?:_\d{3})+\b|\b[A-Z][A-Z0-9]*_[A-Z0-9_]+\b|#\d+\b|\b(?=[0-9a-f]*\d)(?=[0-9a-f]*[a-f])[0-9a-f]{7,40}\b|(?:[\w.-]+\/)+[\w.-]+|\b[\w-]+\.(?:ts|tsx|js|mjs|json|md|py|rs|go|sh|toml|ya?ml)\b)/g
+const DETAILS_MAX = 40
+const DETAILS_MAX_TOKENS = 300
+function detailsOf(v: View, from: number, to: number) {
+  const said = v.messages.slice(from, to).filter((m) => m.role !== 'assistant').map((m) => m.text).join('\n')
+  const seen = new Set<string>()
+  const out: string[] = []
+  let tokens = 0
+  for (let i = from; i < to && out.length < DETAILS_MAX; i++) {
+    const m = v.messages[i]!
+    if (m.role !== 'assistant' || !m.text) continue
+    for (const [whole, ticked, bare] of m.text.matchAll(DETAIL)) {
+      const d = (ticked ?? bare ?? whole).trim()
+      if (d.length < 2 || seen.has(d) || said.includes(d)) continue
+      seen.add(d)
+      if ((tokens += estimateTokens(d) + 1) > DETAILS_MAX_TOKENS || out.length >= DETAILS_MAX) break
+      out.push(d)
+    }
+  }
+  return out
+}
